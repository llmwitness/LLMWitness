{
  "manifest_version": 3,
  "name": "AgentTrace Chrome Auditor",
  "version": "1.0.0",
  "description": "Cryptographic browser mutation and interaction sidecar for AgentTrace compliance auditing",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
