[run]
source = [
    "agenttrace_sdk",
    "gateway",
    "ingest",
    "utils"
]
omit = [
    "tests/*",
    "benchmarks/*",
    "setup.py"
]

[report]
exclude_lines = [
    "pragma: no cover",
    "def __repr__",
    "raise NotImplementedError",
    "if __name__ == .__main__.:",
    "pass"
]
show_missing = true
